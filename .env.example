NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=kloc-intelligence
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=2g
NEO4J_PAGECACHE=512m

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# LLM (used by `enrich`, `explain`, future flow-explanation features).
# Any OpenAI-compatible endpoint works (OpenRouter, Google Gemini, OpenAI, etc.).
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=minimax/minimax-m2.7

# Embeddings (used by `enrich` and `search`). Independent from LLM —
# point at a different provider/key if desired.
EMBEDDING_API_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSION=4096

# Project metadata
KLOC_PROJECT_ROOT=
KLOC_PROJECT_NAME=default
