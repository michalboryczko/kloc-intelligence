NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=kloc-intelligence
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=2g
NEO4J_PAGECACHE=512m

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# LLM (used by `enrich`, `explain`, `enrich-flows`).
# Any OpenAI-compatible endpoint works (OpenRouter, Google Gemini, OpenAI, etc.).
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=minimax/minimax-m2.7

# Embeddings (used by `enrich`, `enrich-flows`, `search`). Independent from
# LLM — point at a different provider/key if desired.
EMBEDDING_API_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSION=4096

# ── Google Gemini (native, OpenAI-compatible) ─────────────────────────────
# Uncomment to use Gemini for both surfaces. Drop Qdrant collections first
# if you're switching dimension (gemini-embedding-001 is 3072, not 4096).
#
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=<your-gemini-api-key>
# LLM_MODEL=gemini-3-flash-preview
#
# EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDING_API_KEY=<your-gemini-api-key>
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSION=3072

# Project metadata
KLOC_PROJECT_ROOT=
KLOC_PROJECT_NAME=default

# ── Test fixtures (only used by `pytest`) ─────────────────────────────────
# Tests that need the canonical PHP reference project look for it via these
# env vars, falling back to ../kloc-reference-project-php/ relative to this
# repo (i.e. the parent-monorepo layout). Override if your checkout lives
# elsewhere, or leave unset to let the affected tests pytest.skip.
#
# KLOC_REFERENCE_PROJECT_ROOT=/path/to/kloc-reference-project-php
# KLOC_REFERENCE_SYMFONY_KLOC=/path/to/kloc-reference-project-php/.kloc/symfony-kloc.json
